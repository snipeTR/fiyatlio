{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fiyatlio",
  "version": "0.3.1",
  "identifier": "com.fiyatlio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fiyatlio — Binance Spot Analiz",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Fiyatlio",
    "category": "Finance",
    "shortDescription": "Binance spot trading analysis",
    "longDescription": "Offline-first desktop application that computes FIFO / Average Cost realized and unrealized P&L from Binance spot trade history CSV exports.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Turkish", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
